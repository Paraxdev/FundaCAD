<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.fundacad.app</id>
  <name>FundaCAD</name>
  <summary>Parametric CAD for 3D printing</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-only</project_license>
  <developer id="dev.fundacad">
    <name>Paraxdev</name>
  </developer>
  <description>
    <p>
      Free, open source parametric CAD for 3D printing. Sketch it, constrain
      it, model it, and export STEP, STL or 3MF.
    </p>
    <p>
      A part is a timeline of features, so you can go back to any one of
      them, change it, and the model rebuilds from there. Built on the Open
      CASCADE geometry kernel.
    </p>
  </description>
  <launchable type="desktop-id">dev.fundacad.app.desktop</launchable>
  <screenshots>
