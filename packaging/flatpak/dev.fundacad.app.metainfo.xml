    </screenshot>
    <screenshot>
      <caption>The main window with the feature history</caption>
      <image>https://raw.githubusercontent.com/Paraxdev/FundaCAD/main/assets/readme/ui-overview.png</image>
    </screenshot>
    <screenshot>
      <caption>Sketching an involute gear profile</caption>
      <image>https://raw.githubusercontent.com/Paraxdev/FundaCAD/main/assets/readme/sketch-gear-profile.png</image>
    </screenshot>
    <screenshot>
      <caption>Materials in the Render workspace</caption>
      <image>https://raw.githubusercontent.com/Paraxdev/FundaCAD/main/assets/readme/render-materials.png</image>
    </screenshot>
  </screenshots>
  <keywords>
    <keyword>CAD</keyword>
