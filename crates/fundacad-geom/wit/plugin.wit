// The geometry half of a FundaCAD plugin bundle, as a WebAssembly component
// (docs/ENGINE.md 2.3, docs/PLUGINS.md "Owning a feature type").
//
// Shapes never cross as BREP bytes: the host keeps every solid, face, wire and
// edge, and a plugin holds `shape` handles. A handle lives as long as the call
// that produced it; nothing survives between calls, each call gets a fresh
// instance.
package fundacad:plugin@0.1.0;

interface types {
  type vec3 = tuple<f64, f64, f64>;

  enum shape-kind { compound, comp-solid, solid, shell, face, wire, edge, vertex, other }

  // `normal` points out of the material (the face orientation is applied).
  record plane { origin: vec3, normal: vec3 }
  record cylinder { origin: vec3, axis: vec3, radius: f64 }
  variant surface { plane(plane), cylinder(cylinder), other(string) }

  record line { origin: vec3, direction: vec3 }
  record circle { center: vec3, axis: vec3, radius: f64 }
  variant curve { line(line), circle(circle), other(string) }

  enum point-state { inside, on, outside }
  enum boolean-op { fuse, cut, common }

  // A triangle soup: xyz per vertex, three indices per triangle, and either
  // no normals or one xyz per vertex.
  record mesh { positions: list<f64>, indices: list<u32>, normals: list<f32> }

  record export-body { id: string, name: string, positions: list<f64>, indices: list<u32> }

  // A face's stored triangulation, the one the host last meshed it with:
  // world positions, the surface (u, v) of every node, and three 0-based node
  // indices per triangle wound as the surface is, the face orientation NOT
  // applied.
  record face-triangulation { positions: list<f64>, uvs: list<f64>, indices: list<u32> }

  // A face's underlying surface as its adaptor sees it, placement applied:
  // `kind` is plane, cylinder, cone or another surface type's name, the axes
  // are the surface's own gp_Ax3 (a plane's too), `radius` a cylinder's
  // radius or a cone's reference radius, `semi-angle` a cone's in radians,
  // and the parameter bounds are the face's.
  record surface-frame {
    kind: string,
    origin: vec3,
    x-dir: vec3,
    y-dir: vec3,
    z-dir: vec3,
    radius: f64,
    semi-angle: f64,
    u-first: f64,
    u-last: f64,
    v-first: f64,
    v-last: f64,
  }

  // The surface at one (u, v): the point, the first derivatives, and the
  // surface normal where it is defined (the face orientation NOT applied).
  record surface-sample { point: vec3, du: vec3, dv: vec3, normal: option<vec3> }

  // How far apart two surfaces may be and still be one: exact, a value in
  // millimetres, or the engine's tolerance for geometry picked off the
  // rendered mesh, sized by the extent of the shapes involved.
  variant fuzzy { exact, value(f64), picked }
  // `clean` merges faces split along a shared surface and unwraps a lone
  // solid from its compound; no validity check is made.
  record boolean-options { parallel: bool, fuzzy: fuzzy, clean: bool }

  record dir-entry { name: string, is-dir: bool }
}

// Always available: cancellation, progress and the engine log.
interface host {
  // True once the person cancelled. A long loop should poll it and return an
  // error; the host also stops a plugin that overruns its time budget.
  cancelled: func() -> bool;
  progress: func(fraction: f64, message: string);
  log: func(message: string);
}

// The generic kernel. Nothing here knows what a fastener, a texture or a
// printer is.
interface kernel {
  use types.{vec3, shape-kind, surface, curve, point-state, boolean-op, mesh, face-triangulation, surface-frame, surface-sample, boolean-options};

  resource shape {
    kind: func() -> shape-kind;
    // Unique sub-shapes in explorer order, degenerate edges left out.
    solids: func() -> list<shape>;
    faces: func() -> list<shape>;
    wires: func() -> list<shape>;
    edges: func() -> list<shape>;
    // A face's outer boundary, and every other wire of it.
    outer-wire: func() -> option<shape>;
    inner-wires: func() -> list<shape>;
    // A face's surface, an edge's curve.
    surface: func() -> surface;
    curve: func() -> curve;
    // Every edge of the shape, explorer order with repeats, sampled at
    // `segments` + 1 evenly spaced curve parameters.
    sample-edges: func(segments: u32) -> list<vec3>;
    // An edge at a fraction of its length.
    point-at: func(position: f64) -> option<vec3>;
    tangent-at: func(position: f64) -> option<vec3>;
    // A planar face's area centroid, a curved face's middle of its UV bounds,
    // anything else's centre of mass.
    center: func() -> option<vec3>;
    // A face's outward normal at the point projected onto it.
    normal-at: func(point: vec3) -> option<vec3>;
    // Solids in order: the first that has the point in or on it decides.
    classify: func(point: vec3, tolerance: f64) -> point-state;
    volume: func() -> f64;
    area: func() -> f64;
    bounding-box: func() -> option<tuple<vec3, vec3>>;
    is-valid: func() -> bool;
    is-same: func(other: borrow<shape>) -> bool;
    // The distinct faces of this shape meeting at `edge`.
    faces-of-edge: func(edge: borrow<shape>) -> list<shape>;
    // The angle between the normals of the two faces at an edge, none on a
    // seam or a free edge.
    dihedral-deg: func(edge: borrow<shape>) -> option<f64>;
    // A face's triangulation at a linear deflection.
    triangulate: func(deflection: f64) -> result<mesh, string>;
    // A face's stored triangulation, none when it has not been meshed.
    triangulation: func() -> option<face-triangulation>;
    // Whether the shape is REVERSED in its parent.
    is-reversed: func() -> bool;
    surface-frame: func() -> option<surface-frame>;
    // The surface at every (u, v) of `uvs`, two numbers each. `tolerance` is
    // the one a normal is judged defined with.
    surface-samples: func(uvs: list<f64>, tolerance: f64) -> list<surface-sample>;
  }

  // A box from its minimum corner.
  make-box: func(corner: vec3, size: vec3) -> result<shape, string>;
  // A cylinder whose bottom disc is centred on `base`, rising along `axis`.
  make-cylinder: func(base: vec3, axis: vec3, radius: f64, height: f64) -> result<shape, string>;
  make-cone: func(base: vec3, axis: vec3, bottom-radius: f64, top-radius: f64, height: f64) -> result<shape, string>;
  make-sphere: func(center: vec3, radius: f64) -> result<shape, string>;
  // A closed planar polygon face.
  polygon-face: func(points: list<vec3>) -> result<shape, string>;
  // A planar face bounded by a closed wire.
  face-from-wire: func(wire: borrow<shape>) -> result<shape, string>;
  // The profile faces of sketch entities, both JSON exactly as a sketch
  // feature stores its `plane` and `entities`. Inside `run-feature` a named
  // datum plane resolves against the document.
  sketch-faces: func(plane: string, entities: string) -> result<list<shape>, string>;
  // A face or wire swept along a vector, and revolved about an axis.
  prism: func(profile: borrow<shape>, direction: vec3) -> result<shape, string>;
  revolve: func(profile: borrow<shape>, origin: vec3, axis: vec3, degrees: f64) -> result<shape, string>;
  // One boolean, the base against every tool at once. A result the checker
  // calls invalid is an error.
  boolean: func(op: boolean-op, base: borrow<shape>, tools: list<borrow<shape>>) -> result<shape, string>;
  // Faces split along a shared surface merged, the input back if that fails.
  unify: func(shape: borrow<shape>) -> shape;
  translate: func(shape: borrow<shape>, offset: vec3) -> result<shape, string>;
  // Carry the local origin to `origin` and local +Z to `z-axis`.
  place: func(shape: borrow<shape>, origin: vec3, z-axis: vec3) -> result<shape, string>;
  compound: func(parts: list<borrow<shape>>) -> shape;
  // Turned by `degrees` about the axis through `origin`.
  rotate: func(shape: borrow<shape>, origin: vec3, axis: vec3, degrees: f64) -> result<shape, string>;

  // Edges, and a wire of edges connected in the order given.
  line-edge: func(start: vec3, end: vec3) -> result<shape, string>;
  arc-edge: func(start: vec3, middle: vec3, end: vec3) -> result<shape, string>;
  circle-edge: func(center: vec3, normal: vec3, radius: f64) -> result<shape, string>;
  wire-from-edges: func(edges: list<borrow<shape>>) -> result<shape, string>;

  // A planar face swept along a helix about the axis, `pitch` of climb per
  // turn over `degrees` of turning, its plane always containing the axis: a
  // revolve that climbs. A negative pitch climbs the other way. The face
  // must sit off the axis.
  helical-sweep: func(profile: borrow<shape>, origin: vec3, axis: vec3, degrees: f64, pitch: f64) -> result<shape, string>;

  // One boolean with its options, the base against every tool at once.
  boolean-with: func(op: boolean-op, base: borrow<shape>, tools: list<borrow<shape>>, options: boolean-options) -> result<shape, string>;

  // The Delaunay triangulation of 2D points (x, y pairs) exactly as
  // scipy.spatial.Delaunay makes it: Qhull 2020.2 with "Qbb Qc Qz Q12 Qt",
  // three point indices per triangle, each counter-clockwise, in Qhull's facet
  // order. A point Qhull finds coplanar is in no triangle.
  delaunay-planar: func(points: list<f64>) -> result<list<u32>, string>;

  // The faces of a shape a face selector (JSON, one selector or a list, as a
  // feature stores it) resolves to, in the engine's lossy tolerant way.
  select-faces: func(shape: borrow<shape>, selectors: string) -> result<list<shape>, string>;

  record blended { shape: shape, skipped: u32 }
  // Every edge at once; with `one-by-one`, a refused batch falls back to one
  // edge at a time on the evolving body and `skipped` counts the refusals.
  fillet: func(shape: borrow<shape>, edges: list<borrow<shape>>, radius: f64, one-by-one: bool) -> result<blended, string>;
  chamfer: func(shape: borrow<shape>, edges: list<borrow<shape>>, distance: f64, distance2: f64, one-by-one: bool) -> result<blended, string>;

  // A closed ellipse edge centred on `center` in the plane normal to
  // `normal`: semi-axis `rx` along `x-dir` (made perpendicular to the normal),
  // `ry` along normal x x-dir. It starts `start` radians from x-dir and runs
  // counterclockwise about the normal, whichever radius is larger.
  ellipse-edge: func(center: vec3, normal: vec3, x-dir: vec3, rx: f64, ry: f64, start: f64) -> result<shape, string>;

  // `ruled` joins the sections with straight lines instead of a smooth
  // surface, `smooth` asks for the kernel's energy smoothing on top, and
  // `match-seams` lets the kernel realign each section's start point and
  // direction; without it the sections are lofted exactly as given.
  record loft-options { ruled: bool, smooth: bool, match-seams: bool }
  // A solid through closed sections (wires, edges or faces' outer wires) in
  // order, closed to a point at either end when one is given.
  loft: func(sections: list<borrow<shape>>, start-point: option<vec3>, end-point: option<vec3>, options: loft-options) -> result<shape, string>;
  // A B-spline edge through the points in order, back through the first
  // when `closed`.
  interpolate-edge: func(points: list<vec3>, closed: bool) -> result<shape, string>;
  // The shape under an affine map, twelve numbers row major
  // [a b c tx, d e f ty, g h i tz]. A map that is not a similarity turns
  // the surfaces into B-splines; a mirroring one is refused.
  gtransform: func(shape: borrow<shape>, matrix: list<f64>) -> result<shape, string>;

  // The content-addressed blob store: a shape by its id, and a shape stored.
  read-blob: func(id: string) -> result<shape, string>;
  write-blob: func(shape: borrow<shape>) -> result<string, string>;
}

// The feature being rebuilt. Only valid inside `run-feature`.
interface feature {
  use kernel.{shape};

  // The feature object exactly as the document stores it, JSON.
  definition: func() -> string;
  // A number or a parameter expression (JSON) resolved against the document.
  number: func(value: string) -> result<f64, string>;

  record picked { body: u32, items: list<shape> }
  // The selectors in a field resolved, grouped by the body each names.
  pick-faces: func(field: string, label: string) -> result<list<picked>, string>;
  pick-edges: func(field: string, label: string) -> result<list<picked>, string>;
  // Body ids in a field, the active body when it is empty.
  target-bodies: func(field: string, label: string) -> result<list<u32>, string>;

  body-shape: func(body: u32) -> result<shape, string>;
  body-name: func(body: u32) -> result<string, string>;
  set-body-shape: func(body: u32, shape: borrow<shape>) -> result<_, string>;
  add-body: func(shape: borrow<shape>, name: option<string>) -> u32;
  // A solid merged into the bodies the way the app's own features merge
  // theirs: `operation` is new, join, cut or intersect, `targets` the body
  // ids it may touch (empty for every visible body it reaches), and `name`
  // labels a new body.
  combine: func(solid: borrow<shape>, operation: string, targets: list<string>, name: option<string>) -> result<_, string>;
  // One entry of the rebuild's diagnostics, JSON; `feature_id` is filled in.
  diagnostic: func(entry: string);
  // Attach a mesh pass spec (JSON with a "pass" key) to a body, for
  // `resolve-pass` and `displace` at tessellation time.
  stash-pass: func(body: u32, spec: string) -> result<_, string>;
}

// The engine's own C math library, element by element. A plugin whose numbers
// must agree bit for bit with another implementation running on the same
// machine (a Python half calling the platform's libm) reads its
// transcendentals here instead of from its own compiled-in copies.
interface numeric {
  enum unary-op { sin, cos, tan, exp, log, acos, asin, atan }
  enum binary-op { pow, hypot, atan2 }
  unary: func(op: unary-op, xs: list<f64>) -> list<f64>;
  // Pairwise over two lists of the same length.
  binary: func(op: binary-op, xs: list<f64>, ys: list<f64>) -> list<f64>;
}

// Reading the machine's files, for a plugin whose manifest grants
// "files.read"; every call is refused otherwise. Paths are absolute.
interface files {
  use types.{dir-entry};

  read: func(path: string) -> result<list<u8>, string>;
  list-dir: func(path: string) -> result<list<dir-entry>, string>;
  is-dir: func(path: string) -> bool;
  is-file: func(path: string) -> bool;
}

// Where an exporter's bytes go. The host picked the path; a plugin never
// names a file.
interface output {
  write: func(bytes: list<u8>) -> result<_, string>;
}

world plugin {
  import host;
  import kernel;
  import feature;
  import output;
  import files;
  import numeric;

  use types.{mesh, export-body};
  use kernel.{shape};

  record mesh-pass { name: string, code-version: u32 }
  // A face a pass claims, with a tag that rides back into `displace` for it.
  record claimed { face: shape, tag: string }
  // `split-creases` is true for the viewport tessellation only, where a
  // pass may hand back unshared vertices for hard shading.
  record displace-options { density-cap: u32, split-creases: bool }
  record registration {
    features: list<string>,
    mesh-passes: list<mesh-pass>,
    exporters: list<string>,
    shape-generators: list<string>,
  }

  // What this component claims. Each name must be declared in the manifest.
  export register: func() -> registration;

  // register_feature: edit the bodies through `feature`. An error is shown to
  // the person as it is.
  export run-feature: func(type-name: string) -> result<_, string>;

  // register_mesh_pass: the faces of a finished body one stashed spec lands
  // on, then one face displaced. The face has just been meshed, its
  // `triangulation` is the one to displace, and the mesh handed back takes
  // its place, wound outward, normals one per vertex or none.
  export resolve-pass: func(pass: string, body: borrow<shape>, spec: string) -> result<list<claimed>, string>;
  export displace: func(pass: string, face: borrow<shape>, spec: string, tag: string, options: displace-options) -> result<mesh, string>;

  // register_exporter: every live body meshed at export grade, written
  // through `output`. The result is an info object, JSON, or "".
  export write-export: func(exporter: string, bodies: list<export-body>, options: string) -> result<string, string>;

  // register_shape_generator: one solid from JSON parameters.
  export generate-shape: func(generator: string, params: string) -> result<shape, string>;
}
