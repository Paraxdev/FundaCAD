{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && node scripts/stage-mcp-server.mjs"
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "linux": {
      "rpm": {
        "compression": {
          "type": "zstd",
          "level": 3
        }
      }
    },
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    },
    "externalBin": [
      "binaries/fundacad-mcp"
    ]
  }
}
