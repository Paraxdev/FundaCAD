  "paramDefs": {
    "innerDiameter": {
      "expr": "20",
      "value": 20,
      "unit": "mm"
    },
    "innerLength": {
      "expr": "40",
      "value": 40,
      "unit": "mm"
    },
    "wall": {
      "expr": "2.4",
      "value": 2.4,
      "unit": "mm"
    },
    "pitch": {
      "expr": "2",
      "value": 2,
      "unit": "mm"
    },
    "clearance": {
      "expr": "0.25",
      "value": 0.25,
      "unit": "mm"
    },
    "threadLength": {
      "expr": "12",
      "value": 12,
      "unit": "mm"
    },
    "chamfer": {
      "expr": "1",
      "value": 1,
      "unit": "mm"
    },
    "spacing": {
      "expr": "8",
      "value": 8,
      "unit": "mm"
    },
    "screwedOn": {
      "expr": "0",
      "value": 0,
      "unit": "count"
    },
    "innerRadius": {
      "expr": "innerDiameter / 2",
      "value": 10.0,
      "unit": "mm"
    },
    "neckRadius": {
      "expr": "innerRadius + wall",
      "value": 12.4,
      "unit": "mm"
    },
    "bodyRadius": {
      "expr": "neckRadius + clearance + wall",
      "value": 15.05,
      "unit": "mm"
    },
    "rimHeight": {
      "expr": "wall + innerLength",
      "value": 42.4,
      "unit": "mm"
    },
    "shoulderHeight": {
      "expr": "rimHeight - threadLength",
      "value": 30.4,
      "unit": "mm"
    },
    "chamferRadius": {
      "expr": "bodyRadius - chamfer",
      "value": 14.05,
      "unit": "mm"
    },
    "capDepth": {
      "expr": "threadLength + pitch + clearance",
      "value": 14.25,
      "unit": "mm"
    },
    "capHeight": {
      "expr": "wall + capDepth",
      "value": 16.65,
      "unit": "mm"
    },
    "ledgeHeight": {
      "expr": "capHeight - pitch - clearance",
      "value": 14.399999999999999,
      "unit": "mm"
    },
    "grooveDepth": {
      "expr": "0.6134 * pitch",
      "value": 1.2268,
      "unit": "mm"
    },
    "breakout": {
      "expr": "pitch / 10",
      "value": 0.2,
      "unit": "mm"
    },
    "grooveHalf": {
      "expr": "tan(30) * (grooveDepth + breakout)",
      "value": 0.8237633640797579,
      "unit": "mm"
    },
    "grooveBottom": {
      "expr": "neckRadius - grooveDepth",
      "value": 11.173200000000001,
      "unit": "mm"
    },
    "grooveOuter": {
      "expr": "neckRadius + breakout",
      "value": 12.6,
      "unit": "mm"
    },
    "grooveStart": {
      "expr": "shoulderHeight + grooveHalf + clearance / 2",
      "value": 31.34876336407976,
      "unit": "mm"
    },
    "grooveTop": {
      "expr": "grooveStart + grooveHalf",
      "value": 32.17252672815952,
      "unit": "mm"
    },
    "grooveLow": {
      "expr": "grooveStart - grooveHalf",
      "value": 30.525,
      "unit": "mm"
    },
    "grooveTurns": {
      "expr": "ceil(threadLength / pitch)",
      "value": 6,
      "unit": "count"
    },
    "grooveAngle": {
      "expr": "360 * grooveTurns",
      "value": 2160,
      "unit": "deg"
    },
    "flankPlay": {
      "expr": "clearance / cos(30)",
      "value": 0.28867513459481287,
      "unit": "mm"
    },
    "crestRadius": {
      "expr": "grooveBottom + 3 * clearance",
      "value": 11.923200000000001,
      "unit": "mm"
    },
    "crestHalf": {
      "expr": "pitch / 2 - tan(30) * 3 * clearance + flankPlay",
      "value": 0.8556624327025936,
      "unit": "mm"
    },
    "rootRadius": {
      "expr": "neckRadius + clearance",
      "value": 12.65,
      "unit": "mm"
    },
    "reliefRadius": {
      "expr": "rootRadius + clearance / 2",
      "value": 12.775,
      "unit": "mm"
    },
    "rootHalf": {
      "expr": "pitch / 2 - tan(30) * (grooveDepth + clearance) + flankPlay",
      "value": 0.4360442570555737,
      "unit": "mm"
    },
    "mouthRadius": {
      "expr": "crestRadius - clearance / 2",
      "value": 11.798200000000001,
      "unit": "mm"
    },
    "mouthHalf": {
      "expr": "crestHalf + tan(30) * (crestRadius - mouthRadius)",
      "value": 0.9278312163512967,
      "unit": "mm"
    },
    "capStart": {
      "expr": "wall + mouthHalf + clearance / 2",
      "value": 3.4528312163512966,
      "unit": "mm"
    },
    "mouthTop": {
      "expr": "capStart + mouthHalf",
      "value": 4.380662432702593,
      "unit": "mm"
    },
    "mouthLow": {
      "expr": "capStart - mouthHalf",
      "value": 2.525,
      "unit": "mm"
    },
    "rootTop": {
      "expr": "capStart + rootHalf",
      "value": 3.8888754734068702,
      "unit": "mm"
    },
    "rootLow": {
      "expr": "capStart - rootHalf",
      "value": 3.016786959295723,
      "unit": "mm"
    },
    "capTurns": {
      "expr": "ceil(capDepth / pitch)",
      "value": 8,
      "unit": "count"
    },
    "capAngle": {
      "expr": "360 * capTurns",
      "value": 2880,
      "unit": "deg"
    },
    "capShift": {
      "expr": "2 * bodyRadius + spacing",
      "value": 38.1,
      "unit": "mm"
    },
    "layoutOn": {
      "expr": "1 - screwedOn",
      "value": 1,
      "unit": "count"
    },
    "seatHeight": {
      "expr": "capHeight + shoulderHeight + clearance / 2",
      "value": 47.175,
      "unit": "mm"
    },
    "seatTurn": {
      "expr": "0.5 - (seatHeight - capStart - grooveStart) / pitch",
      "value": -5.68670270978447,
      "unit": "count"
    },
    "seatAngle": {
      "expr": "360 * (seatTurn - floor(seatTurn))",
      "value": 112.78702447759088,
      "unit": "deg"
    },
    "d1": {
