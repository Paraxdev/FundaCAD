{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    // vue-tsc requires a jsx setting even though this project has no JSX.
    "jsx": "preserve"
  },
  // No `declare module "*.vue"` shim, deliberately: it would win over vue-tsc's
  // real resolution and silently switch off prop type-checking.
  //
  // plugins/ is here because a shipped plugin's code is this app's code living
  // in its own directory, and it is imported by the app at build time. Leaving
  // it out was not a decision, it was what happened when those files moved out
  // of src/, and the effect was two modules that compiled into the bundle
  // without anybody checking their types. A deliberate error in one of them
  // produced no output at all, which is how it was found.
  "include": ["src/**/*.ts", "src/**/*.vue", "tests/**/*.ts", "plugins/**/*.ts"]
}
